{
  "manifest_version": 3,
  "name": "Clone to My Drive",
  "version": "1.0.0",
  "description": "Clone the current Google Drive file or folder into your saved destination folder.",
  "action": {
    "default_title": "Clone to My Drive",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "storage",
    "tabs",
    "system.display"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "774523235096-5ptemq5ismm6aseagpkekfc4s6d596ns.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
